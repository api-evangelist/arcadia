        {
          "id": "cfdaffca-3ed1-43f5-9344-4f8477fd2d80",
          "name": "Ping",
          "request": {
            "name": "Ping",
            "description": {
              "content": "No-op authorization test endpoint. Returns a 200 if requested with a valid Bearer auth token.\nAny valid authorization token with any scope will be able to get a 200 from this endpoint.\n",
              "type": "text/plain"
            },
            "url": {
