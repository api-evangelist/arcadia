        {
          "id": "d803eb5e-e433-40f3-a936-082b9bfc151e",
          "name": "Create a Connect Token",
          "request": {
            "name": "Create a Connect Token",
            "description": {
              "content": "The Connect front-end component must be initialized with a Connect Token scoped to the user entering the *Connect* flow.\n\nFor new users, or users creating an additional utility credential, post with a unique `client_user_id` parameter. For users editing an existing utility credential, post with the `utility_credential_id` parameter corresponding to the utility credential to be updated. Make sure the `Authorization` header is set to `Bearer ${ACCESS_TOKEN}`.\n\nTokens expire after two hours.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "connect_token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
